{
  "manifest_version": 3,
  "name": "Subtil Controls for YouTube",
  "short_name": "Subtil",
  "version": "1.7.2",
  "description": "Extra controls, built into the YouTube playback bar you already know.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "css": [
        "src/player.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
